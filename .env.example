# ═══════════════════════════════════════════════════════════════════════
# Configuración de bin-service para Render
# ═══════════════════════════════════════════════════════════════════════

# Puerto (Render asigna automáticamente, pero lo mantenemos aquí)
PORT=3000

# CORS - Permitir all origins (o especificar dominio)
ALLOWED_ORIGIN=*

# ═══════════════════════════════════════════════════════════════════════
# TELEGRAM - Credenciales del Bot
# ═══════════════════════════════════════════════════════════════════════
# Token del bot de Telegram (obtén en @BotFather)
TELEGRAM_TOKEN=TU_TOKEN_AQUI

# Chat ID del canal donde recibir mensajes (obtén con @userinfobot)
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# ═══════════════════════════════════════════════════════════════════════
# URL PÚBLICA - Para que Render no duerma el servidor
# ═══════════════════════════════════════════════════════════════════════
# Ejemplo: https://bin-service-abc123.onrender.com
# Se obtiene después de hacer deploy en Render
PUBLIC_URL=https://bin-service-xxxx.onrender.com
